{
  "name": "oh-my-pi-zh",
  "version": "0.1.0",
  "description": "Chinese TUI localization plugin for oh-my-pi (omp) — non-intrusive runtime UI localization",
  "license": "MIT",
  "author": "Xeltra233",
  "type": "module",
  "main": "./dist/extension.js",
  "bin": {
    "oh-my-pi-zh": "./bin/oh-my-pi-zh.js"
  },
  "files": [
    "dist/",
    "bin/",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xeltra233/oh-my-pi-zh.git"
  },
  "keywords": [
    "omp-package",
    "omp-plugin",
    "omp-extension",
    "omp",
    "oh-my-pi",
    "pi-package",
    "pi-extension",
    "pi",
    "coding-agent",
    "chinese",
    "i18n",
    "localization",
    "tui"
  ],
  "omp": {
    "extensions": [
      "./dist/extension.js"
    ]
  },
  "pi": {
    "extensions": [
      "./dist/extension.js"
    ]
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": ">=18.0.0",
    "@oh-my-pi/pi-tui": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    },
    "@oh-my-pi/pi-tui": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
